.env
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
dist/
build/
*.egg-info/
.DS_Store
*.log
/videos/*
!videos/.gitkeep

# Ignore gemini_manim directory
gemini_manim/

# Output and test files
output/
*.wav
*.mp4

# Service account keys (keep *.json broad to block GCP keys, but whitelist CDK config)
*.json
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.node.json
!cdk.json
!cdk.context.json

# Local dev secrets and environments
.env.local
.env.*.local

# CDK synth output
serverless/cdk/cdk.out/
serverless/motion/cdk/cdk.out/

# Local dev workspace (30GB of rendered videos + its own .env)
iris-local/

# Music library (large media)
*.mp3

# Local prompt-engineering scratch experiment (renders ~170MB of PNG frames)
prompt_test/

# Batch job scratch. app/common.py puts every job's workdir under
# SERVE_ROOT/work/<video_id> — it has to live under the static-server root or
# the browser cannot fetch the piece — which means running any job locally
# drops downloaded MP4s, candidate frames and rendered slides straight into the
# tree. Tens of MB per run, all reproducible, none of it source.
serverless/motion/work/

# motion-video piece workspaces: source is tracked, artifacts are not.
# Each of these is 1-3 GB of node_modules, virtualenvs and rendered PNG frames.
*_test/node_modules/
*_test/.venv/
*_test/out/frames/
*_test/out/*.png
*_test/data/*.png
serverless/motion/cdk/node_modules/
serverless/motion/app/__pycache__/

# Rendered video is a build artifact and blows past GitHub's 100 MB file limit.
*.mp4
*.wav
spider_test/out/frames

# The repo ignores *.json globally (line 25), but the motion pipeline ships data
# files the container cannot run without: the seed scene's physics data and its
# narration script. Negate them explicitly so they stay tracked.
!serverless/motion/app/seed_aurora.json
!serverless/motion/app/seed_narration.json
!serverless/motion/app/data/aurora.json
!serverless/motion/cdk/cdk.context.json
!aurora_test/data/aurora.json
